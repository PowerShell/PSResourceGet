<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.PowerShell.PSResourceGet</RootNamespace>
    <AssemblyName>Microsoft.PowerShell.PSResourceGet</AssemblyName>
    <AssemblyVersion>1.1.0.1</AssemblyVersion>
    <FileVersion>1.1.0.1</FileVersion>
    <InformationalVersion>1.1.0.1</InformationalVersion>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.15" />
    <PackageReference Include="NuGet.Commands" Version="7.9.0" />
    <PackageReference Include="NuGet.Common" Version="7.9.0" />
    <PackageReference Include="NuGet.Configuration" Version="7.9.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="PowerShellStandard.Library" Version="7.0.0-preview.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="OrasProject.Oras" Version="0.5.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
      <InternalsVisibleTo Include="Benchmarks" />
  </ItemGroup>

  <Target Name="CoreTypes" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'NuGet.Protocol.Core.Types'">
        <Aliases>CoreTypes</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
